{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@rynex/ui/*": ["../../packages/ui/src/*"],
      "@rynex/ui": ["../../packages/ui/src"],
      "@rynex/db": ["../../packages/db/src"],
      "@rynex/auth": ["../../packages/auth/src"],
      "@rynex/types": ["../../packages/types/src"],
      "@rynex/config": ["../../packages/config/src"],
      "@rynex/utils": ["../../packages/utils/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
